{
  "name": "tickets-service",
  "version": "1.0.0",
  "description": "Microservicio de generación y validación de entradas",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node ../scripts/db-migrate.js tickets",
