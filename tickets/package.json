    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "pdfkit": "^0.16.0",
    "qrcode": "^1.5.4",
    "sequelize": "^6.37.5"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
