  {
    "id": "column.public.User.password",
    "label": "Add column \"password\" to \"User\"",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "column",
        "name": "password",
        "table": "User"
      }
    },
    "precheck": [
      {
        "description": "ensure column \"password\" is missing",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"information_schema\".\"columns\" WHERE (\"table_schema\" = $1 AND \"table_name\" = $2 AND \"column_name\" = $3)) AS \"result\"",
        "params": [
          "public",
          "User",
          "password"
        ],
        "expectation": {
          "expects": "absent",
          "object": "column \"password\" on \"User\""
        }
      }
    ],
    "execute": [
      {
        "description": "add column \"password\"",
        "sql": "ALTER TABLE \"public\".\"User\" ADD COLUMN \"password\" text"
      }
    ],
    "postcheck": [
      {
        "description": "verify column \"password\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"information_schema\".\"columns\" WHERE (\"table_schema\" = $1 AND \"table_name\" = $2 AND \"column_name\" = $3)) AS \"result\"",
        "params": [
          "public",
          "User",
          "password"
        ],
        "expectation": {
          "expects": "present",
          "object": "column \"password\" on \"User\""
        }
      },
      {
        "description": "verify column \"password\" has type \"text\"",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_attribute\" AS \"a\" INNER JOIN \"pg_class\" AS \"c\" ON \"c\".\"oid\" = \"a\".\"attrelid\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"relnamespace\" WHERE (\"n\".\"nspname\" = $1 AND \"c\".\"relname\" = $2 AND \"a\".\"attname\" = $3 AND (format_type(\"a\".\"atttypid\", \"a\".\"atttypmod\")) = $4 AND NOT (\"a\".\"attisdropped\"))) AS \"result\"",
        "params": [
          "public",
          "User",
          "password",
          "text"
        ]
      }
    ]
  },
